    "gate1:verify": "node scripts/run_gate1_tests.mjs",
    "gate2:verify": "node scripts/run_gate2_tests.mjs",
    "start": "node dist/apps/api/src/server.js"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.21"
  },
  "dependencies": {
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
