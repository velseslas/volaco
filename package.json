{
  "name": "volaco-core",
  "version": "0.1.0",
  "description": "VibeCode Studio Core - Modular Monolith Platform Engine",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
