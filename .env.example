# ==============================================================================
# VOLACO CORE — EXEMPLE DE CONFIGURATION D'ENVIRONNEMENT SÉCURISÉ
# Ne jamais versionner de vraies clés secrètes dans ce fichier ou dans le dépôt.
# ==============================================================================

# [SEC-001] Secret HMAC-SHA256 obligatoire pour la signature et vérification des tokens JWT.
# Exigence stricte : minimum 32 caractères cryptographiques à haute entropie.
AUTH_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_D_AU_MOINS_32_CARACTERES

# [SEC-003] Clé API Mistral pour le proxy serveur sécurisé (/api/v1/ai/chat/completions).
# Ne JAMAIS écrire une clé réelle ici ni dans un fichier versionné (le passé
# l'a prouvé : deux clés ont déjà fui via ce dépôt et ont dû être révoquées).
# Renseigner votre clé obtenue sur console.mistral.ai :
MISTRAL_API_KEY=VOTRE_CLE_MISTRAL_PRIVEE

# [SEC-002] Clé d'API exigée par le serveur en production (en-tête Authorization:
# Bearer). Absente en production, une clé éphémère est générée à chaque démarrage.
VOLACO_API_KEY=

# Origines autorisées en cross-origin (CORS), séparées par des virgules.
# Laisser vide = même origine uniquement (recommandé pour un usage local).
CORS_ALLOWED_ORIGINS=

# Port d'écoute du serveur HTTP API
PORT=3000

# Environnement d'exécution (production | development | test)
NODE_ENV=production

# P0 — mode STRICT : désactive le repli dev (x-tenant-id / x-user-role spoofables).
# Toute requête API sans Bearer valide (JWT ou VOLACO_API_KEY) est refusée 401,
# sauf /auth/* et /health. Défaut : désactivé (mode local mono-utilisateur).
VOLACO_STRICT_AUTH=0
